import LeanSlang
import Ninfer.Ops.LinearT2.Kernels

/-!
# `emit_ninfer` — write the kernels as Slang

    emit_ninfer <outDir> [--mutant <name>] [--probe] [--glue] [--unchecked]

For each kernel of `Ninfer.Ops.LinearT2.kernels` (`Ninfer.Slang.Kernel` describes the two forms):

* `<name>.slang`: the kernel as one module, barriers in, for the targets that run a group in
  parallel (SPIR-V, Metal);
* `<stem>.slang` for each process of a kernel that has a barrier: the DAG of executes, for the
  targets that run a group's threads one after another (C++). A kernel without a barrier is its own
  module and has no such files;
* `manifest.txt`: what a host needs to dispatch either form;
* with `--glue`, `<stem>_glue.cpp` for each module: the C++ host entry `tests/kernels/cpu_host.cpp` calls.

`--probe` emits the FP32-total probes; `--mutant` plants one fault (`sequential-fold`,
`decode-illegal`, `no-guard`, `tie-away`, `merge-all`, `merge-fold`, `drop-edges`, `reverse-edges`).
Each DAG is checked before anything is written (`Dag.check`); `--unchecked` skips that, for the
mutants that exist to show the dynamic gates catch what the static one would.
`kernels/gen.exs` takes it from there (slangc to C++, SPIR-V and Metal).
-/

open LeanSlang Ninfer.Slang Ninfer.Slang.Dag Ninfer.Ops.LinearT2

def elemBytes : String → Nat
  | "uint8_t" => 1
  | "int8_t" => 1
  | "uint16_t" => 2
  | _ => 4

/-- One kernel in the manifest. The `kernel` line carries the group width, the constant buffer's
fields and the number of processes; then the buffers by binding, the shared arrays (host buffers
in the process form: name, element type, bytes per element, elements per group), the processes in
execution order, and the edges, by position in the DAG. -/
def manifestEntry (k : Kernel) (mods : List ProcModule) : String :=
  let head := s!"kernel {k.name} threads {k.threads} params {k.fields.length} procs {mods.length}"
  let bufs := k.bufs.zipIdx.map fun (b, ix) =>
    s!"buf {ix + 1} {b.name} {b.elem} {elemBytes b.elem} {if b.rw then "rw" else "ro"}"
  let shared : List (Buf × SlangGroupSharedDecl) :=
    match mods with
    | m :: _ => (m.bufs.drop k.bufs.length).zip k.dag.shared
    | [] => []
  let scratch := shared.map fun (b, s) => s!"scratch {b.name} {b.elem} {elemBytes b.elem} {sharedSize s}"
  let procs := mods.map fun m => s!"proc {m.index} {m.stem} {m.procName}"
  let edges := k.dag.edges.map fun (i, j) => s!"edge {i} {j}"
  String.intercalate "\n" ([head] ++ bufs ++ scratch ++ procs ++ edges)

def cType : String → String
  | "uint" => "uint32_t"
  | n => n

/-- The host entry of one module: `kernel_run`, over a constant buffer of `u32`s and buffers by
binding order. It runs the group's threads itself, one at a time (`main_0_Thread`), so a host can
ask for the last lane first. Each module is its own translation unit, so the prelude names do not
collide. -/
def glue (m : ProcModule) : String :=
  let setBufs := m.bufs.zipIdx.map fun (b, ix) =>
    s!"\tg.{b.name}_0.data = ({cType b.elem} *)bufs[{ix}];\n\tg.{b.name}_0.count = counts[{ix}];"
  String.intercalate "\n"
    [ s!"// Generated by `emit_ninfer --glue`: the host entry of {m.stem}."
    , "// `precise` is an HLSL qualifier slangc passes through; C++ has none. The host build compiles"
    , "// with -ffp-contract=off, which is what it asks for."
    , "#define precise"
    , s!"#include \"{m.stem}_emit.cpp\""
    , "#include <cstdint>"
    , "#include <cstring>"
    , "// Every thread of every group, one after another. `reverse` runs each group's threads from the"
    , "// last to the first: a process whose result changes with that order has a hazard between lanes."
    , "extern \"C\" void kernel_run(const uint32_t *params, uint8_t *const *bufs, const size_t *counts,"
    , "\t\tuint32_t gx, uint32_t gy, uint32_t gz, int reverse) {"
    , s!"\tstatic_assert(sizeof({m.paramsStruct}_0) == {4 * m.nFields}, \"the parameters are {m.nFields} u32\");"
    , s!"\t{m.paramsStruct}_0 p;"
    , "\tstd::memcpy(&p, params, sizeof p);"
    , "\tGlobalParams_0 g{};"
    , "\tg.params_0 = &p;"
    , String.intercalate "\n" setBufs
    , "\tComputeThreadVaryingInput ti{};"
    , "\tfor (uint32_t z = 0; z < gz; ++z)"
    , "\t\tfor (uint32_t y = 0; y < gy; ++y)"
    , "\t\t\tfor (uint32_t x = 0; x < gx; ++x)"
    , s!"\t\t\t\tfor (uint32_t i = 0; i < {m.threads}; ++i) \{"
    , s!"\t\t\t\t\tconst uint32_t lane = reverse ? {m.threads - 1} - i : i;"
    , "\t\t\t\t\tti.groupID = uint3(x, y, z);"
    , "\t\t\t\t\tti.groupThreadID = uint3(lane, 0u, 0u);"
    , "\t\t\t\t\tmain_0_Thread(&ti, nullptr, &g);"
    , "\t\t\t\t}"
    , "}"
    , "" ]

def parseMutant : String → Option Mutant
  | "sequential-fold" => some .sequentialFold
  | "decode-illegal" => some .decodeIllegal
  | "no-guard" => some .noGuard
  | "tie-away" => some .tieAway
  | "merge-all" => some .mergeAll
  | "merge-fold" => some .mergeFold
  | "drop-edges" => some .dropEdges
  | "reverse-edges" => some .reverseEdges
  | _ => none

structure Opts where
  cfg : Cfg := {}
  glue : Bool := false
  unchecked : Bool := false
  out : Option String := none

partial def parseArgs (args : List String) (o : Opts) : Except String Opts :=
  match args with
  | [] => if o.out.isSome then .ok o else .error "no output directory"
  | "--probe" :: rest => parseArgs rest { o with cfg := { o.cfg with probe := true } }
  | "--glue" :: rest => parseArgs rest { o with glue := true }
  | "--unchecked" :: rest => parseArgs rest { o with unchecked := true }
  | "--mutant" :: name :: rest =>
    match parseMutant name with
    | some m => parseArgs rest { o with cfg := { o.cfg with mutant := m } }
    | none => .error s!"unknown mutant {name}"
  | a :: rest => parseArgs rest { o with out := some a }

def main (args : List String) : IO UInt32 := do
  match parseArgs args {} with
  | .error e =>
    IO.eprintln s!"emit_ninfer: {e}\nusage: emit_ninfer <outDir> [--mutant <name>] [--probe] [--glue] [--unchecked]"
    return 2
  | .ok o =>
    let outDir := o.out.getD "."
    IO.FS.createDirAll outDir
    let ks := kernels o.cfg
    let mut manifest : List String := []
    let mut files := 0
    for k in ks do
      if !o.unchecked then
        if let .error e := k.dag.check then
          IO.eprintln s!"emit_ninfer: {k.name}: {e}"
          return 1
      let (fusedMod, mods) ← match k.fused, k.modules with
        | .ok f, .ok ms => pure (f, ms)
        | .error e, _ | _, .error e =>
          IO.eprintln s!"emit_ninfer: {k.name}: {e}"
          return 1
      IO.FS.writeFile s!"{outDir}/{k.name}.slang" (LeanSlang.emit fusedMod ++ "\n")
      files := files + 1
      for m in mods do
        if m.stem != k.name then
          IO.FS.writeFile s!"{outDir}/{m.stem}.slang" (LeanSlang.emit m.shader ++ "\n")
          files := files + 1
        if o.glue then
          IO.FS.writeFile s!"{outDir}/{m.stem}_glue.cpp" (glue m)
      manifest := manifest ++ [manifestEntry k mods]
    IO.FS.writeFile s!"{outDir}/manifest.txt" (String.intercalate "\n" manifest ++ "\n")
    IO.println s!"wrote {ks.length} kernels ({files} files) to {outDir}"
    return 0
