"""Qwen tool-call output parser; mirrors `src/models/qwen3_5/frontend/tool_call_parser.{h,cpp}`.

The model writes a call as `<tool_call><function=NAME><parameter=KEY>VALUE</parameter>...`. This
module turns generated text into content plus structured calls: a strict reader for well-formed
regions, a lenient recovery pass for broken ones (a call it cannot read becomes a call to the
reserved `malformed_tool_call` tool), parameter normalization against the declared tool schemas,
and the streaming decoder that decides which bytes can be shown while a call may still open.

Text is `List[UInt8]` throughout, because generated bytes need not be valid UTF-8; only the
names, arguments and tool definitions, which the C++ also hands to nlohmann, become `String`.
"""

from std.collections import List

from ninfer.artifact.json import (
    Json,
    json_accepts,
    parse_json,
    ARRAY,
    BOOL,
    FLOAT,
    NEG,
    NULL,
    OBJECT,
    STRING,
    UINT,
)
from ninfer.text.jinja.value import json_escape
from ninfer.text.json_out import JsonOut

# --- ToolCallParseFallbackReason ---------------------------------------------------------------

comptime R_NONE = 0
comptime R_MALFORMED_STRUCTURE = 1
comptime R_DUPLICATE_PARAMETER = 2
comptime R_INVALID_TOOL_NAME = 3
comptime R_UNDECLARED_TOOL = 4
comptime R_TRAILING_CONTENT = 5


# Real tool schemas nest a handful of levels. `Json::parse` has no bound, so a caller that must accept
# anything it accepts passes a larger `max_depth` (the reader recurses; about 60,000 overflows the stack).
comptime DEFAULT_TOOL_JSON_MAX_DEPTH = 64


def fallback_reason_name(reason: Int) -> String:
    if reason == R_NONE:
        return "none"
    if reason == R_DUPLICATE_PARAMETER:
        return "duplicate_parameter"
    if reason == R_INVALID_TOOL_NAME:
        return "invalid_tool_name"
    if reason == R_UNDECLARED_TOOL:
        return "undeclared_tool"
    if reason == R_TRAILING_CONTENT:
        return "trailing_content"
    return "malformed_structure"


# --- the output contract -----------------------------------------------------------------------

comptime T_NULL = 1
comptime T_BOOLEAN = 2
comptime T_INTEGER = 4
comptime T_NUMBER = 8
comptime T_STRING = 16
comptime T_OBJECT = 32
comptime T_ARRAY = 64


struct ContractParameter(Copyable, Movable):
    var name: String
    var declared_types: Bool  # NormalizationPolicy::DeclaredTypes (else Legacy)
    var types: Int

    def __init__(out self, name: String):
        self.name = name
        self.declared_types = False
        self.types = 0


struct ContractTool(Copyable, Movable):
    var name: String
    var parameters: List[ContractParameter]
    var unambiguous: Bool

    def __init__(out self):
        self.name = String()
        self.parameters = List[ContractParameter]()
        self.unambiguous = True


struct ToolCallOutputContract(Copyable, Movable):
    var enabled: Bool  # the C++ passes a null contract when tool calling is off
    var tools: List[ContractTool]
    var enforce_declared_names: Bool
    var forced_tool_name: String

    def __init__(out self):
        self.enabled = False
        self.tools = List[ContractTool]()
        self.enforce_declared_names = False
        self.forced_tool_name = String()


struct GeneratedToolCall(Copyable, Movable):
    var name: String
    var arguments_json: String

    def __init__(out self, name: String, arguments_json: String):
        self.name = name
        self.arguments_json = arguments_json


struct ToolCallParseDiagnostics(Copyable, Movable):
    var marker_seen: Bool
    var forced_call_closed: Bool
    var structured_call_count: Int
    var empty_arguments_omitted: Int
    var schema_mismatch_arguments: Int
    var duplicate_parameters_repaired: Int
    var fallback_reason: Int
    var recovered: Bool
    var recovered_call_count: Int
    var malformed_call_reported: Bool
    var trailing_content_dropped: Bool

    def __init__(out self):
        self.marker_seen = False
        self.forced_call_closed = False
        self.structured_call_count = 0
        self.empty_arguments_omitted = 0
        self.schema_mismatch_arguments = 0
        self.duplicate_parameters_repaired = 0
        self.fallback_reason = R_NONE
        self.recovered = False
        self.recovered_call_count = 0
        self.malformed_call_reported = False
        self.trailing_content_dropped = False


struct ParsedToolCallOutput(Copyable, Movable):
    var is_tool_call_response: Bool
    var content: List[UInt8]
    var tool_calls: List[GeneratedToolCall]
    var diagnostics: ToolCallParseDiagnostics

    def __init__(out self):
        self.is_tool_call_response = False
        self.content = List[UInt8]()
        self.tool_calls = List[GeneratedToolCall]()
        self.diagnostics = ToolCallParseDiagnostics()


# --- markers and byte helpers ------------------------------------------------------------------

comptime TOOL_OPEN = "<tool_call>"
comptime TOOL_CLOSE = "</tool_call>"
comptime FUNCTION_OPEN = "<function="
comptime FUNCTION_CLOSE = "</function>"
comptime FUNCTION_CALLS_OPEN = "<function_calls>"
comptime FUNCTION_CALLS_CLOSE = "</function_calls>"
comptime THINK_OPEN = "<think>"
comptime THINK_CLOSE = "</think>"

# Reserved name for a call the recovery pass could not read.
comptime MALFORMED_CALL_TOOL = "malformed_tool_call"

# Markers tried as the start of the structured turn, the first one included.
comptime MAX_MARKER_ATTEMPTS = 16

comptime NPOS = -1


def _is_ws(b: UInt8) -> Bool:
    return b == 0x20 or b == 0x09 or b == 0x0D or b == 0x0A


def _is_digit(b: UInt8) -> Bool:
    return b >= 0x30 and b <= 0x39


def _is_alnum(b: UInt8) -> Bool:
    return (b >= 0x61 and b <= 0x7A) or (b >= 0x41 and b <= 0x5A) or _is_digit(b)


def _starts_with_at(text: List[UInt8], pos: Int, prefix: String) -> Bool:
    var p = prefix.as_bytes()
    if pos < 0 or pos + len(p) > len(text):
        return False
    for i in range(len(p)):
        if text[pos + i] != p[i]:
            return False
    return True


def _find(text: List[UInt8], needle: String, from_pos: Int) -> Int:
    var n = needle.as_bytes()
    var i = from_pos
    while i + len(n) <= len(text):
        var hit = True
        for k in range(len(n)):
            if text[i + k] != n[k]:
                hit = False
                break
        if hit:
            return i
        i += 1
    return NPOS


def _find_byte(text: List[UInt8], b: UInt8, from_pos: Int) -> Int:
    var i = from_pos
    while i < len(text):
        if text[i] == b:
            return i
        i += 1
    return NPOS


def _rfind_before(text: List[UInt8], needle: String, end: Int) -> Int:
    """Last occurrence of `needle` that lies entirely inside text[0:end]."""
    var n = needle.as_bytes()
    var i = end - len(n)
    while i >= 0:
        var hit = True
        for k in range(len(n)):
            if text[i + k] != n[k]:
                hit = False
                break
        if hit:
            return i
        i -= 1
    return NPOS


def _slice(text: List[UInt8], begin: Int, end: Int) -> List[UInt8]:
    var out = List[UInt8]()
    for i in range(begin, end):
        out.append(text[i])
    return out^


def _text_of(bytes: List[UInt8]) -> String:
    return String(unsafe_from_utf8=bytes)


def _bytes_of(s: String) -> List[UInt8]:
    var out = List[UInt8]()
    for b in s.as_bytes():
        out.append(b)
    return out^


def _same(text: List[UInt8], b0: Int, e0: Int, b1: Int, e1: Int) -> Bool:
    if e0 - b0 != e1 - b1:
        return False
    for i in range(e0 - b0):
        if text[b0 + i] != text[b1 + i]:
            return False
    return True


def _equals(text: List[UInt8], begin: Int, end: Int, s: String) -> Bool:
    var p = s.as_bytes()
    if end - begin != len(p):
        return False
    for i in range(len(p)):
        if text[begin + i] != p[i]:
            return False
    return True


def _rtrim(text: List[UInt8], end_in: Int) -> List[UInt8]:
    var end = end_in
    while end != 0 and _is_ws(text[end - 1]):
        end -= 1
    return _slice(text, 0, end)


# A (begin, end) byte range of the text being read.
struct Span2(Copyable, Movable):
    var begin: Int
    var end: Int

    def __init__(out self, begin: Int, end: Int):
        self.begin = begin
        self.end = end


def _trim(text: List[UInt8], begin_in: Int, end_in: Int) -> Span2:
    var begin = begin_in
    var end = end_in
    while begin < end and _is_ws(text[begin]):
        begin += 1
    while end > begin and _is_ws(text[end - 1]):
        end -= 1
    return Span2(begin, end)


def _skip_ws(text: List[UInt8], mut pos: Int):
    while pos < len(text) and _is_ws(text[pos]):
        pos += 1


# --- tag forms ---------------------------------------------------------------------------------
# Beside the Qwen forms (<function=NAME>, <parameter=NAME>), agent harnesses write
# <function name="NAME">, <invoke name="NAME"> and <param name="NAME">. Every opening tag is
# closed by its own kind.


def _form_open(function: Bool, form: Int) -> String:
    if function:
        return "<function" if form == 0 else "<invoke"
    return "<parameter" if form == 0 else "<param"


def _form_close(function: Bool, form: Int) -> String:
    if function:
        return "</function>" if form == 0 else "</invoke>"
    return "</parameter>" if form == 0 else "</param>"


def _opens_tag(text: List[UInt8], pos: Int, function: Bool, form: Int) -> Bool:
    var open = _form_open(function, form)
    if not _starts_with_at(text, pos, open):
        return False
    var next = pos + open.byte_length()
    return next < len(text) and (text[next] == 0x3D or _is_ws(text[next]))


def _tag_form_at(text: List[UInt8], pos: Int, function: Bool) -> Int:
    """0 or 1 for the form opening at `pos`, -1 for none."""
    for form in range(2):
        if _opens_tag(text, pos, function, form):
            return form
    return -1


def _unquote(text: List[UInt8], begin: Int, end: Int) -> Span2:
    var t = _trim(text, begin, end)
    if t.end - t.begin >= 2 and (text[t.begin] == 0x22 or text[t.begin] == 0x27) and text[t.end - 1] == text[t.begin]:
        return _trim(text, t.begin + 1, t.end - 1)
    return t^


def _tag_name(text: List[UInt8], header_begin: Int, header_end: Int) -> Span2:
    """The name in a tag header: `=NAME`, or a `name` attribute, quoted or not. Other attributes
    are skipped whole, so `filename="x"` never supplies the name. Empty when there is none."""
    var header = _trim(text, header_begin, header_end)
    var begin = header.begin
    var end = header.end
    if begin < end and text[begin] == 0x3D:
        return _unquote(text, begin + 1, end)
    var pos = begin
    while pos < end:
        while pos < end and _is_ws(text[pos]):
            pos += 1
        var attribute_begin = pos
        while pos < end and text[pos] != 0x3D and not _is_ws(text[pos]):
            pos += 1
        var attribute_end = pos
        while pos < end and _is_ws(text[pos]):
            pos += 1
        if pos == end or text[pos] != 0x3D:
            continue
        pos += 1
        while pos < end and _is_ws(text[pos]):
            pos += 1
        var value_begin = pos
        var value_end = pos
        if pos < end and (text[pos] == 0x22 or text[pos] == 0x27):
            var quote = text[pos]
            var close = NPOS
            for k in range(pos + 1, end):
                if text[k] == quote:
                    close = k
                    break
            var stop = end if close == NPOS else close
            value_begin = pos + 1
            value_end = stop
            pos = end if stop == end else stop + 1
        else:
            value_begin = pos
            while pos < end and not _is_ws(text[pos]) and text[pos] != 0x2F:
                pos += 1
            value_end = pos
        if _equals(text, attribute_begin, attribute_end, "name"):
            return _trim(text, value_begin, value_end)
    return Span2(0, 0)


struct TagHeader(Copyable, Movable):
    var begin: Int
    var end: Int  # of the header text
    var tag_end: Int  # position of '>', NPOS when there is none

    def __init__(out self, begin: Int, end: Int, tag_end: Int):
        self.begin = begin
        self.end = end
        self.tag_end = tag_end


def _tag_header(text: List[UInt8], pos: Int, function: Bool, form: Int) -> TagHeader:
    var header_begin = pos + _form_open(function, form).byte_length()
    var tag_end = _find_byte(text, 0x3E, header_begin)
    if tag_end == NPOS:
        return TagHeader(0, 0, NPOS)
    return TagHeader(header_begin, tag_end, tag_end)


def _header_name(text: List[UInt8], header: TagHeader) -> Span2:
    if header.tag_end == NPOS:
        return Span2(0, 0)
    return _tag_name(text, header.begin, header.end)


# Openers of a tool-call region: the wrapper, the container, and a bare function of any form.
def _marker(index: Int) -> String:
    if index == 0:
        return TOOL_OPEN
    if index == 1:
        return FUNCTION_CALLS_OPEN
    if index == 2:
        return "<function="
    if index == 3:
        return "<function "
    if index == 4:
        return "<invoke="
    return "<invoke "


comptime MARKER_COUNT = 6


def _could_open_marker(prefix: List[UInt8]) -> Bool:
    for i in range(MARKER_COUNT):
        var marker = _marker(i).as_bytes()
        if len(prefix) > len(marker):
            continue
        var ok = True
        for k in range(len(prefix)):
            if prefix[k] != marker[k]:
                ok = False
                break
        if ok:
            return True
    return False


def _opens_marker_at(text: List[UInt8], pos: Int) -> Bool:
    for i in range(MARKER_COUNT):
        if _starts_with_at(text, pos, _marker(i)):
            return True
    return False


def _unclosed(before: List[UInt8], open: String, close: String) -> Bool:
    var opened = _rfind_before(before, open, len(before))
    if opened == NPOS:
        return False
    var closed = _rfind_before(before, close, len(before))
    return closed == NPOS or closed < opened


def _inside_open_wrapper(text: List[UInt8], pos: Int) -> Bool:
    """A bare function inside an unclosed <tool_call> or <function_calls> belongs to that opener's
    region, so it never starts a region of its own."""
    var before = _slice(text, 0, pos)
    return _unclosed(before, TOOL_OPEN, TOOL_CLOSE) or _unclosed(before, FUNCTION_CALLS_OPEN, FUNCTION_CALLS_CLOSE)


def _find_tool_marker(text: List[UInt8], from_pos: Int) -> Int:
    var pos = _find_byte(text, 0x3C, from_pos)
    while pos != NPOS:
        if _opens_marker_at(text, pos):
            if (
                _starts_with_at(text, pos, TOOL_OPEN)
                or _starts_with_at(text, pos, FUNCTION_CALLS_OPEN)
                or not _inside_open_wrapper(text, pos)
            ):
                return pos
        pos = _find_byte(text, 0x3C, pos + 1)
    return NPOS


def _opens_call(text: List[UInt8], pos: Int) -> Bool:
    return _starts_with_at(text, pos, TOOL_OPEN) or _tag_form_at(text, pos, True) >= 0


def _valid_function_name(text: List[UInt8], name: Span2, max_name_length: Int) -> Bool:
    var size = name.end - name.begin
    if size == 0 or size > max_name_length:
        return False
    for i in range(name.begin, name.end):
        var b = text[i]
        if not (_is_alnum(b) or b == 0x5F or b == 0x2D):
            return False
    return True


# --- building the contract ---------------------------------------------------------------------


def _schema_type(name: String) -> Int:
    if name == "null":
        return T_NULL
    if name == "boolean":
        return T_BOOLEAN
    if name == "integer":
        return T_INTEGER
    if name == "number":
        return T_NUMBER
    if name == "string":
        return T_STRING
    if name == "object":
        return T_OBJECT
    if name == "array":
        return T_ARRAY
    return 0


def _compile_direct_types(doc: Json, node: Int) -> Int:
    """Type bits of a `type` member, 0 when it is not a supported declaration."""
    if doc.is_string(node):
        return _schema_type(doc.string(node))
    if not doc.is_array(node) or doc.size(node) == 0:
        return 0
    var bits = 0
    for i in range(doc.size(node)):
        var member = doc.at(node, i)
        if not doc.is_string(member):
            return 0
        var one = _schema_type(doc.string(member))
        if one == 0:
            return 0
        bits |= one
    return bits


def _compile_schema_types(doc: Json, schema: Int) -> Int:
    if not doc.is_object(schema):
        return 0
    var direct = doc.find(schema, "type")
    if direct >= 0:
        return _compile_direct_types(doc, direct)
    var any_of = doc.find(schema, "anyOf")
    var one_of = doc.find(schema, "oneOf")
    var has_any = any_of >= 0
    var has_one = one_of >= 0
    if has_any == has_one:
        return 0
    var alternatives = any_of if has_any else one_of
    if not doc.is_array(alternatives) or doc.size(alternatives) == 0:
        return 0
    var combined = 0
    for i in range(doc.size(alternatives)):
        var branch = _compile_schema_types(doc, doc.at(alternatives, i))
        if branch == 0:
            return 0
        combined |= branch
    return combined


def _compile_tool_contract(doc: Json, definition: Int) -> ContractTool:
    var contract = ContractTool()
    if not doc.is_object(definition):
        return contract^
    var function = doc.find(definition, "function")
    if function < 0 or not doc.is_object(function):
        return contract^
    var name = doc.find(function, "name")
    if name < 0 or not doc.is_string(name):
        return contract^
    contract.name = doc.string(name)
    var schema = doc.find(function, "parameters")
    if schema < 0 or not doc.is_object(schema):
        return contract^
    var properties = doc.find(schema, "properties")
    if properties < 0 or not doc.is_object(properties):
        return contract^
    for i in range(doc.size(properties)):
        var parameter = ContractParameter(doc.key(properties, i))
        var bits = _compile_schema_types(doc, doc.at(properties, i))
        if bits != 0:
            parameter.declared_types = True
            parameter.types = bits
        contract.parameters.append(parameter^)
    return contract^


def _same_contract(lhs: ContractTool, rhs: ContractTool) -> Bool:
    if len(lhs.parameters) != len(rhs.parameters):
        return False
    for i in range(len(lhs.parameters)):
        ref left = lhs.parameters[i]
        ref right = rhs.parameters[i]
        if left.name != right.name or left.declared_types != right.declared_types or left.types != right.types:
            return False
    return True


def _append_tool_contract(mut contracts: ToolCallOutputContract, doc: Json, definition: Int):
    var compiled = _compile_tool_contract(doc, definition)
    if compiled.name.byte_length() == 0:
        return
    for i in range(len(contracts.tools)):
        if contracts.tools[i].name == compiled.name:
            if contracts.tools[i].unambiguous and not _same_contract(contracts.tools[i], compiled):
                contracts.tools[i].parameters = List[ContractParameter]()
                contracts.tools[i].unambiguous = False
            return
    contracts.tools.append(compiled^)


def build_tool_call_output_contract(
    tool_jsons: List[String],
    enabled: Bool,
    forced_tool_name: String = String(),
    max_depth: Int = DEFAULT_TOOL_JSON_MAX_DEPTH,
) -> ToolCallOutputContract:
    """With `enabled` false the contract is the C++'s null one: the decoder passes text through.
    A tool definition nested deeper than `max_depth` is discarded, as one that does not parse is."""
    var contract = ToolCallOutputContract()
    if not enabled:
        return contract^
    contract.enabled = True
    contract.enforce_declared_names = True
    contract.forced_tool_name = forced_tool_name
    for tool_json in tool_jsons:
        var doc = Json()
        try:
            var root = parse_json(_bytes_of(tool_json), "tool definition", doc, False, max_depth)
            _append_tool_contract(contract, doc, root)
        except:
            pass  # Json::parse(..., allow_exceptions=false) discards what it cannot parse
    return contract^


def _find_tool(contract: ToolCallOutputContract, name: List[UInt8]) -> Int:
    var wanted = name.copy()
    for i in range(len(contract.tools)):
        var tool_name = contract.tools[i].name.as_bytes()
        if len(tool_name) != len(wanted):
            continue
        var same = True
        for k in range(len(wanted)):
            if tool_name[k] != wanted[k]:
                same = False
                break
        if same:
            return i
    return -1


def _find_parameter(tool: ContractTool, name: List[UInt8]) -> Int:
    for i in range(len(tool.parameters)):
        var parameter_name = tool.parameters[i].name.as_bytes()
        if len(parameter_name) != len(name):
            continue
        var same = True
        for k in range(len(name)):
            if parameter_name[k] != name[k]:
                same = False
                break
        if same:
            return i
    return -1


# --- parameter normalization -------------------------------------------------------------------

comptime P_EMITTED = 0
comptime P_OMITTED = 1
comptime P_SCHEMA_MISMATCH = 2

# JsonValueKind
comptime K_NULL = 0
comptime K_BOOLEAN = 1
comptime K_INTEGER = 2
comptime K_NUMBER = 3
comptime K_STRING = 4
comptime K_OBJECT = 5
comptime K_ARRAY = 6


struct NormalizedParameter(Copyable, Movable):
    var disposition: Int
    var json_value: String

    def __init__(out self, disposition: Int, json_value: String):
        self.disposition = disposition
        self.json_value = json_value


def _remove_parameter_framing_newlines(text: List[UInt8], begin_in: Int, end_in: Int) -> Span2:
    var begin = begin_in
    var end = end_in
    var size = end_in - begin_in
    if size >= 2 and text[begin] == 0x0D and text[begin + 1] == 0x0A:
        begin += 2
    elif size >= 1 and text[begin] == 0x0A:
        begin += 1
    if end >= begin + 2 and text[end - 2] == 0x0D and text[end - 1] == 0x0A:
        end -= 2
    elif end > begin and text[end - 1] == 0x0A:
        end -= 1
    return Span2(begin, end)


def _ascii_case_equal(text: List[UInt8], begin: Int, end: Int, lowercase: String) -> Bool:
    var l = lowercase.as_bytes()
    if end - begin != len(l):
        return False
    for i in range(len(l)):
        var b = text[begin + i]
        if b >= 0x41 and b <= 0x5A:
            b = b + 32
        if b != l[i]:
            return False
    return True


def _json_number_is_integer(text: List[UInt8], begin: Int, end: Int) -> Bool:
    var pos = begin + (1 if end > begin and text[begin] == 0x2D else 0)
    if pos >= end:
        return False
    var integer_begin = pos
    while pos < end and _is_digit(text[pos]):
        pos += 1
    var integer_end = pos

    var fraction_begin = pos
    var fraction_end = pos
    if pos < end and text[pos] == 0x2E:
        pos += 1
        fraction_begin = pos
        while pos < end and _is_digit(text[pos]):
            pos += 1
        fraction_end = pos

    var exponent_negative = False
    var exponent_value = 0
    if pos < end and (text[pos] == 0x65 or text[pos] == 0x45):
        pos += 1
        if pos < end and (text[pos] == 0x2B or text[pos] == 0x2D):
            exponent_negative = text[pos] == 0x2D
            pos += 1
        var cap = end - begin
        while pos < end and _is_digit(text[pos]):
            var digit = Int(text[pos]) - 0x30
            if exponent_value != cap:
                if exponent_value > cap // 10 or (exponent_value == cap // 10 and digit > cap % 10):
                    exponent_value = cap
                else:
                    exponent_value = exponent_value * 10 + digit
            pos += 1
    if integer_begin == integer_end or pos != end:
        return False

    var coefficient_is_zero = True
    var trailing_zeros = 0
    for i in range(integer_begin, integer_end):
        if text[i] == 0x30:
            trailing_zeros += 1
        else:
            coefficient_is_zero = False
            trailing_zeros = 0
    for i in range(fraction_begin, fraction_end):
        if text[i] == 0x30:
            trailing_zeros += 1
        else:
            coefficient_is_zero = False
            trailing_zeros = 0
    if coefficient_is_zero:
        return True

    var fraction_digits = fraction_end - fraction_begin
    if not exponent_negative:
        if exponent_value >= fraction_digits:
            return True
        return fraction_digits - exponent_value <= trailing_zeros
    if exponent_value > trailing_zeros:
        return False
    return fraction_digits <= trailing_zeros - exponent_value


def _json_accepts(text: List[UInt8], begin: Int, end: Int) -> Bool:
    """`nlohmann::json::accept`: the range is one complete JSON value."""
    return json_accepts(_slice(text, begin, end))


def _classify_json_value(text: List[UInt8], begin: Int, end: Int) -> Int:
    """The JsonValueKind of a complete JSON value, -1 when it is not one."""
    if end == begin or not _json_accepts(text, begin, end):
        return -1
    var first = text[begin]
    if first == 0x6E:  # n
        return K_NULL
    if first == 0x74 or first == 0x66:  # t f
        return K_BOOLEAN
    if first == 0x22:
        return K_STRING
    if first == 0x7B:
        return K_OBJECT
    if first == 0x5B:
        return K_ARRAY
    if first == 0x2D or _is_digit(first):
        return K_INTEGER if _json_number_is_integer(text, begin, end) else K_NUMBER
    return -1


def _admits_value(types: Int, kind: Int) -> Bool:
    if kind == K_NULL:
        return (types & T_NULL) != 0
    if kind == K_BOOLEAN:
        return (types & T_BOOLEAN) != 0
    if kind == K_INTEGER:
        return (types & T_INTEGER) != 0 or (types & T_NUMBER) != 0
    if kind == K_NUMBER:
        return (types & T_NUMBER) != 0
    if kind == K_STRING:
        return (types & T_STRING) != 0
    if kind == K_OBJECT:
        return (types & T_OBJECT) != 0
    if kind == K_ARRAY:
        return (types & T_ARRAY) != 0
    return False


def _encode_json_string(text: List[UInt8], begin: Int, end: Int) raises -> String:
    """`Json(std::string(value)).dump()`; invalid UTF-8 raises, as nlohmann's dump does."""
    return json_escape(_text_of(_slice(text, begin, end)), False)


def _encode_json_name(name: List[UInt8]) raises -> String:
    return _encode_json_string(name, 0, len(name))


def _normalize_declared_parameter(text: List[UInt8], begin: Int, end: Int, types: Int) raises -> NormalizedParameter:
    var framed = _remove_parameter_framing_newlines(text, begin, end)
    if (types & T_STRING) != 0:
        return NormalizedParameter(P_EMITTED, _encode_json_string(text, framed.begin, framed.end))

    var value = _trim(text, framed.begin, framed.end)
    if value.begin == value.end:
        return NormalizedParameter(P_OMITTED, String())

    var kind = _classify_json_value(text, value.begin, value.end)
    if kind >= 0:
        return NormalizedParameter(
            P_EMITTED if _admits_value(types, kind) else P_SCHEMA_MISMATCH,
            _text_of(_slice(text, value.begin, value.end)),
        )

    if (types & T_BOOLEAN) != 0:
        if _ascii_case_equal(text, value.begin, value.end, "true"):
            return NormalizedParameter(P_EMITTED, "true")
        if _ascii_case_equal(text, value.begin, value.end, "false"):
            return NormalizedParameter(P_EMITTED, "false")
    return NormalizedParameter(P_SCHEMA_MISMATCH, _encode_json_string(text, framed.begin, framed.end))


def _normalize_parameter(text: List[UInt8], begin: Int, end: Int, declared: Bool, types: Int) raises -> NormalizedParameter:
    if declared:
        return _normalize_declared_parameter(text, begin, end, types)
    var value = _trim(text, begin, end)
    if _json_accepts(text, value.begin, value.end):
        return NormalizedParameter(P_EMITTED, _text_of(_slice(text, value.begin, value.end)))
    return NormalizedParameter(P_EMITTED, _encode_json_string(text, value.begin, value.end))


# --- the region parser -------------------------------------------------------------------------


struct RawParameter(Copyable, Movable):
    var name: Span2
    var value: Span2

    def __init__(out self, name: Span2, value: Span2):
        self.name = name.copy()
        self.value = value.copy()


struct RawToolCall(Copyable, Movable):
    var name: Span2
    var parameters: List[RawParameter]

    def __init__(out self):
        self.name = Span2(0, 0)
        self.parameters = List[RawParameter]()


struct QwenToolRegionParser(Movable):
    """The strict reader accepts only complete, declared calls. The lenient one, used by the
    recovery pass on a call the strict reader rejected, also takes an undeclared name (the client
    answers with its own unknown-tool error), a parameter whose close tag is missing right before
    its function closes, and a call missing only its outer close tag."""

    var text: List[UInt8]
    var max_name_length: Int
    var contract: ToolCallOutputContract
    var lenient: Bool
    var duplicate_parameters_repaired: Int

    def __init__(
        out self, var text: List[UInt8], max_name_length: Int, contract: ToolCallOutputContract, lenient: Bool = False
    ):
        self.text = text^
        self.max_name_length = max_name_length
        self.contract = contract.copy()
        self.lenient = lenient
        self.duplicate_parameters_repaired = 0

    def parse_one(mut self, mut pos: Int, mut call: RawToolCall) -> Int:
        """One call starting at pos: a <tool_call> or a bare function. On failure pos is left
        inside the call."""
        if _starts_with_at(self.text, pos, TOOL_OPEN):
            return self._parse_tool_call(pos, call)
        return self._parse_function(pos, call)

    def parse(mut self, mut calls: List[RawToolCall]) -> Int:
        var pos = 0
        while True:
            _skip_ws(self.text, pos)
            if pos == len(self.text):
                return R_MALFORMED_STRUCTURE if len(calls) == 0 else R_NONE
            if self._consume(pos, FUNCTION_CALLS_OPEN):
                var before = len(calls)
                while True:
                    _skip_ws(self.text, pos)
                    if self._consume(pos, FUNCTION_CALLS_CLOSE):
                        break
                    var call = RawToolCall()
                    var failure = self._parse_function(pos, call)
                    if failure != R_NONE:
                        return failure
                    calls.append(call^)
                if len(calls) == before:
                    return R_MALFORMED_STRUCTURE
                continue
            if not _opens_call(self.text, pos):
                return R_MALFORMED_STRUCTURE if len(calls) == 0 else R_TRAILING_CONTENT
            var call = RawToolCall()
            var failure = self.parse_one(pos, call)
            if failure != R_NONE:
                return failure
            calls.append(call^)

    def _consume(self, mut pos: Int, token: String) -> Bool:
        if not _starts_with_at(self.text, pos, token):
            return False
        pos += token.byte_length()
        return True

    def _parse_tool_call(mut self, mut pos: Int, mut call: RawToolCall) -> Int:
        if not self._consume(pos, TOOL_OPEN):
            return R_MALFORMED_STRUCTURE
        _skip_ws(self.text, pos)
        var failure = self._parse_function(pos, call)
        if failure != R_NONE:
            return failure
        _skip_ws(self.text, pos)
        if self._consume(pos, TOOL_CLOSE):
            return R_NONE
        if self.lenient and (pos == len(self.text) or _starts_with_at(self.text, pos, TOOL_OPEN)):
            return R_NONE
        return R_MALFORMED_STRUCTURE

    def _parse_function(mut self, mut pos: Int, mut call: RawToolCall) -> Int:
        var form = _tag_form_at(self.text, pos, True)
        if form < 0:
            return R_MALFORMED_STRUCTURE
        var header = _tag_header(self.text, pos, True, form)
        call.name = _header_name(self.text, header)
        if header.tag_end == NPOS or not _valid_function_name(self.text, call.name, self.max_name_length):
            return R_INVALID_TOOL_NAME
        if not self.lenient and self.contract.enforce_declared_names:
            if _find_tool(self.contract, _slice(self.text, call.name.begin, call.name.end)) < 0:
                return R_UNDECLARED_TOOL
        pos = header.tag_end + 1

        var close = _form_close(True, form)
        while True:
            _skip_ws(self.text, pos)
            if self._consume(pos, close):
                return R_NONE
            var failure = self._parse_parameter(pos, close, call)
            if failure != R_NONE:
                return failure

    def _parse_parameter(mut self, mut pos: Int, function_close: String, mut call: RawToolCall) -> Int:
        var form = _tag_form_at(self.text, pos, False)
        if form < 0:
            return R_MALFORMED_STRUCTURE
        var header = _tag_header(self.text, pos, False, form)
        var name = _header_name(self.text, header)
        if header.tag_end == NPOS or name.begin == name.end:
            return R_MALFORMED_STRUCTURE

        var value_begin = header.tag_end + 1
        var value_end = 0
        var next = 0
        var close = _form_close(False, form)
        var unclosed_end = self._find_unclosed_parameter_end(value_begin, function_close)
        var closed_end = NPOS
        if not (self.lenient and unclosed_end != NPOS):
            closed_end = self._find_parameter_close(value_begin, form, function_close)
        if self.lenient and unclosed_end != NPOS:
            value_end = unclosed_end
            next = unclosed_end
        elif closed_end != NPOS:
            value_end = closed_end
            next = closed_end + close.byte_length()
        else:
            return R_MALFORMED_STRUCTURE
        var value = Span2(value_begin, value_end)
        # A repeated parameter keeps its last value, as JSON object syntax would, rather than
        # discarding an otherwise well-formed call.
        var existing = -1
        for i in range(len(call.parameters)):
            if _same(self.text, call.parameters[i].name.begin, call.parameters[i].name.end, name.begin, name.end):
                existing = i
                break
        if existing >= 0:
            call.parameters[existing].value = value^
            self.duplicate_parameters_repaired += 1
        else:
            call.parameters.append(RawParameter(name, value))
        pos = next
        return R_NONE

    def _find_unclosed_parameter_end(self, value_begin: Int, function_close: String) -> Int:
        """A value that runs straight into its function's close tag, with no parameter tag of any
        kind on the way. Any parameter markup in between makes the boundary a guess, and a
        guessed boundary could cut a command short, so that stays unreadable."""
        var close = _find(self.text, function_close, value_begin)
        if close == NPOS:
            return NPOS
        var value = _slice(self.text, value_begin, close)
        if _find(value, "</param", 0) != NPOS or _find(value, "<param", 0) != NPOS:
            return NPOS
        return close

    def _find_parameter_open_before(self, scan: Int, limit: Int, form: Int) -> Int:
        """End of a nested opening tag of the same kind, complete before `limit`; NPOS if none."""
        var open = _form_open(False, form)
        var candidate = _find(self.text, open, scan)
        while candidate != NPOS and candidate < limit:
            if _opens_tag(self.text, candidate, False, form):
                var header = _tag_header(self.text, candidate, False, form)
                var name = _header_name(self.text, header)
                if name.begin != name.end and header.tag_end < limit:
                    return header.tag_end + 1
            candidate = _find(self.text, open, candidate + 1)
        return NPOS

    def _ends_value(self, pos_in: Int, function_close: String) -> Bool:
        """The format has no escape, so a value that quotes its own closing tag is ambiguous. A
        closer ends the value only where the call can go on after it (after whitespace): the end
        of the output, another parameter, the tool close, or the function's own close followed by
        the end, the tool close, the next call or the container close. A closer that runs into a
        call opener or a reasoning tag is a broken call rather than payload, so it still ends the
        value and the break is reported. Anything else after it -- text, a function close that
        runs on into text, or markup such as the HTML or template of a Write/Edit payload --
        makes it value text."""
        var pos = pos_in
        _skip_ws(self.text, pos)
        if (
            pos == len(self.text)
            or _tag_form_at(self.text, pos, False) >= 0
            or _starts_with_at(self.text, pos, TOOL_CLOSE)
            or _opens_call(self.text, pos)
            or _starts_with_at(self.text, pos, FUNCTION_CALLS_OPEN)
            or _starts_with_at(self.text, pos, FUNCTION_CALLS_CLOSE)
            or _starts_with_at(self.text, pos, THINK_OPEN)
            or _starts_with_at(self.text, pos, THINK_CLOSE)
        ):
            return True
        if not _starts_with_at(self.text, pos, function_close):
            return False
        pos += function_close.byte_length()
        _skip_ws(self.text, pos)
        return (
            pos == len(self.text)
            or _starts_with_at(self.text, pos, TOOL_CLOSE)
            or _opens_call(self.text, pos)
            or _starts_with_at(self.text, pos, FUNCTION_CALLS_CLOSE)
        )

    def _find_parameter_close(self, value_begin: Int, form: Int, function_close: String) -> Int:
        var close_tag = _form_close(False, form)
        var depth = 1
        var scan = value_begin
        while True:
            var close = _find(self.text, close_tag, scan)
            if close == NPOS:
                return NPOS
            var nested_open_end = self._find_parameter_open_before(scan, close, form)
            if nested_open_end != NPOS:
                depth += 1
                scan = nested_open_end
                continue
            if depth != 1 or self._ends_value(close + close_tag.byte_length(), function_close):
                depth -= 1
            if depth == 0:
                return close
            scan = close + close_tag.byte_length()


def _normalize_raw_tool_call(
    text: List[UInt8], raw: RawToolCall, contract: ToolCallOutputContract, mut diagnostics: ToolCallParseDiagnostics
) raises -> GeneratedToolCall:
    var tool = _find_tool(contract, _slice(text, raw.name.begin, raw.name.end))
    if tool >= 0 and not contract.tools[tool].unambiguous:
        tool = -1

    var arguments = String("{")
    var first = True
    for p in raw.parameters:
        var parameter = -1
        var name = _slice(text, p.name.begin, p.name.end)
        if tool >= 0:
            parameter = _find_parameter(contract.tools[tool], name)
        var declared = False
        var types = 0
        if parameter >= 0:
            declared = contract.tools[tool].parameters[parameter].declared_types
            types = contract.tools[tool].parameters[parameter].types
        var normalized = _normalize_parameter(text, p.value.begin, p.value.end, declared, types)
        if tool >= 0 and parameter < 0:
            normalized.disposition = P_SCHEMA_MISMATCH
        if normalized.disposition == P_OMITTED:
            diagnostics.empty_arguments_omitted += 1
            continue
        if normalized.disposition == P_SCHEMA_MISMATCH:
            diagnostics.schema_mismatch_arguments += 1
        if not first:
            arguments += ","
        first = False
        arguments += _encode_json_name(name)
        arguments += ":"
        arguments += normalized.json_value
    arguments += "}"
    return GeneratedToolCall(_text_of(_slice(text, raw.name.begin, raw.name.end)), arguments)


def _fallback(text: List[UInt8], diagnostics: ToolCallParseDiagnostics) -> ParsedToolCallOutput:
    var out = ParsedToolCallOutput()
    out.content = text.copy()
    out.diagnostics = diagnostics.copy()
    return out^


def _opened_function(text: List[UInt8], mut pos: Int) -> Int:
    """The function form a region or call opens, after its wrapper or container opener; -1 if none."""
    if _starts_with_at(text, pos, TOOL_OPEN):
        pos += TOOL_OPEN.byte_length()
    elif _starts_with_at(text, pos, FUNCTION_CALLS_OPEN):
        pos += FUNCTION_CALLS_OPEN.byte_length()
    _skip_ws(text, pos)
    return _tag_form_at(text, pos, True)


def _region_opens_function(region: List[UInt8]) -> Bool:
    """Markup that never opens a function is prose about tool calls, not an attempt at one. The
    Qwen form counts from its opener; another form only with a name, so prose about a
    <function ...> tag stays prose."""
    var pos = 0
    var form = _opened_function(region, pos)
    if form < 0:
        return False
    if _starts_with_at(region, pos, FUNCTION_OPEN):
        return True
    var header = _tag_header(region, pos, True, form)
    var name = _header_name(region, header)
    return name.begin != name.end and header.tag_end != NPOS


def _malformed_call_arguments(call_text: List[UInt8], max_name_length: Int) raises -> String:
    var intended = String()
    var pos = 0
    var form = _opened_function(call_text, pos)
    if form >= 0:
        var header = _tag_header(call_text, pos, True, form)
        var name = _header_name(call_text, header)
        if header.tag_end != NPOS and _valid_function_name(call_text, name, max_name_length):
            intended = _text_of(_slice(call_text, name.begin, name.end))
    var function_close = _form_close(True, form) if form >= 0 else String(FUNCTION_CLOSE)
    var message: String
    if _find(call_text, function_close, 0) == NPOS:
        message = (
            "The output ended before the tool call was closed, so nothing was executed. Issue "
            "the call again; if it was long, split the work into smaller calls."
        )
    else:
        message = (
            "The tool call markup was malformed, so nothing was executed. Issue the call again "
            "with every parameter opened and closed by its own tag."
        )
    # nlohmann::ordered_json keeps insertion order: intended_function, then error.
    var out = String("{")
    if intended.byte_length() > 0:
        out += '"intended_function":' + json_escape(intended, False) + ","
    out += '"error":' + json_escape(message, False) + "}"
    return out


def _recover_tool_calls(
    region: List[UInt8], max_name_length: Int, contract: ToolCallOutputContract, mut out: ParsedToolCallOutput
) raises:
    """The strict pass rejected the region. Calls it can read still stand; a call it cannot read
    gets the lenient reader, and a call neither can read is reported as a call to the reserved
    error tool, so the model sees an error and retries instead of its turn ending on raw markup.
    Nothing after that point is trusted. Text after the last call is a tool result the model went
    on to imagine, and it is dropped."""
    var strict = QwenToolRegionParser(region.copy(), max_name_length, contract)
    var lenient = QwenToolRegionParser(region.copy(), max_name_length, contract, True)
    var pos = 0
    while True:
        _skip_ws(region, pos)
        if pos == len(region):
            break
        if _starts_with_at(region, pos, FUNCTION_CALLS_OPEN):
            pos += FUNCTION_CALLS_OPEN.byte_length()
            continue
        if _starts_with_at(region, pos, FUNCTION_CALLS_CLOSE):
            pos += FUNCTION_CALLS_CLOSE.byte_length()
            continue
        if not _opens_call(region, pos):
            out.diagnostics.trailing_content_dropped = True
            break
        var start = pos
        var call = RawToolCall()
        var strict_repaired = strict.duplicate_parameters_repaired
        if strict.parse_one(pos, call) == R_NONE:
            out.diagnostics.duplicate_parameters_repaired += strict.duplicate_parameters_repaired - strict_repaired
            out.tool_calls.append(_normalize_raw_tool_call(region, call, contract, out.diagnostics))
            continue
        pos = start
        call = RawToolCall()
        var lenient_repaired = lenient.duplicate_parameters_repaired
        if lenient.parse_one(pos, call) == R_NONE:
            out.diagnostics.duplicate_parameters_repaired += lenient.duplicate_parameters_repaired - lenient_repaired
            out.diagnostics.recovered_call_count += 1
            out.tool_calls.append(_normalize_raw_tool_call(region, call, contract, out.diagnostics))
            continue
        out.tool_calls.append(
            GeneratedToolCall(
                MALFORMED_CALL_TOOL,
                _malformed_call_arguments(_slice(region, start, len(region)), max_name_length),
            )
        )
        out.diagnostics.malformed_call_reported = True
        break
    out.diagnostics.recovered = True


def parse_qwen_tool_call_output(
    text: List[UInt8], max_tool_name_length: Int, contract: ToolCallOutputContract
) raises -> ParsedToolCallOutput:
    var candidate = _find_tool_marker(text, 0)
    if candidate == NPOS:
        return _fallback(text, ToolCallParseDiagnostics())

    var out = ParsedToolCallOutput()
    out.diagnostics.marker_seen = True

    # Generated prose can quote a tool-call marker before the real turn. Try each marker in order
    # and accept the first region that consumes the response to its end; earlier markers stay
    # ordinary content. Every attempt can scan to the end of the output, so an output that keeps
    # repeating the marker is tried only up to a bound. The bound counts from the first marker,
    # not the last, so no call of a multi-call turn is ever left behind as text.
    var first = candidate
    var raw_calls = List[RawToolCall]()
    var accepted = NPOS
    var first_failure = R_MALFORMED_STRUCTURE
    var first_failure_recorded = False
    var attempt = 0
    while candidate != NPOS and attempt < MAX_MARKER_ATTEMPTS:
        var calls = List[RawToolCall]()
        var parser = QwenToolRegionParser(_slice(text, candidate, len(text)), max_tool_name_length, contract)
        var failure = parser.parse(calls)
        if failure == R_NONE:
            accepted = candidate
            raw_calls = calls^
            out.diagnostics.duplicate_parameters_repaired = parser.duplicate_parameters_repaired
            break
        if not first_failure_recorded:
            first_failure = failure
            first_failure_recorded = True
            # A first region that opens with a complete call is the real turn, broken later on:
            # it goes to recovery rather than yielding to a later marker.
            if len(calls) != 0:
                break
        candidate = _find_tool_marker(text, candidate + 1)
        attempt += 1
    if accepted == NPOS:
        # No marker opens a region that parses: recover what the first one's region holds.
        out.diagnostics.fallback_reason = first_failure
        var tool_region = _slice(text, first, len(text))
        if not _region_opens_function(tool_region):
            return _fallback(text, out.diagnostics)
        out.content = _rtrim(text, first)
        _recover_tool_calls(tool_region, max_tool_name_length, contract, out)
    else:
        out.content = _rtrim(text, accepted)
        # The calls hold offsets into the region that was parsed, which starts at the marker.
        var region = _slice(text, accepted, len(text))
        for raw in raw_calls:
            out.tool_calls.append(_normalize_raw_tool_call(region, raw, contract, out.diagnostics))
    out.diagnostics.structured_call_count = len(out.tool_calls)
    out.is_tool_call_response = True
    return out^


# --- the streaming decoder ---------------------------------------------------------------------


struct DecoderTerminal(Movable):
    var content: List[UInt8]
    var tool_calls: List[GeneratedToolCall]
    var diagnostics: ToolCallParseDiagnostics

    def __init__(out self):
        self.content = List[UInt8]()
        self.tool_calls = List[GeneratedToolCall]()
        self.diagnostics = ToolCallParseDiagnostics()


struct ToolCallOutputDecoder(Movable):
    """Incrementally publishes bytes that are provably outside a possible terminal Qwen tool-call
    suffix. At terminal time, valid calls are retained structurally. A region that opens a
    function but fails the strict reader goes through recovery: readable calls are kept and an
    unreadable one becomes a call to the reserved error tool. Only markup that never opens a
    function is restored verbatim. When the prompt already carries the opener of a forced call,
    the decoder is seeded with that opener, because the model never emits it."""

    var contract: ToolCallOutputContract
    var trailing_whitespace: List[UInt8]
    var tool_region: List[UInt8]
    # A '<' and what follows while it can still grow into a tool-call region opener.
    var pending_marker: List[UInt8]
    # Bytes of tool_region that came from the prompt's opener rather than from the model. The
    # fallback path returns the region as ordinary content, and these must not appear there.
    var seeded_prefix_bytes: Int
    var max_tool_name_length: Int
    var saw_tool_marker: Bool
    var forced: Bool
    var finished: Bool

    def __init__(out self, contract: ToolCallOutputContract, max_tool_name_length: Int):
        self.contract = contract.copy()
        self.trailing_whitespace = List[UInt8]()
        self.tool_region = List[UInt8]()
        self.pending_marker = List[UInt8]()
        self.seeded_prefix_bytes = 0
        self.max_tool_name_length = max_tool_name_length
        self.saw_tool_marker = False
        self.forced = False
        self.finished = False
        if not contract.enabled or contract.forced_tool_name.byte_length() == 0:
            return
        # The generation prompt ends with exactly this opener, so generation resumes inside the
        # call and the region the parser sees has to begin where the prompt left off.
        self.tool_region = _bytes_of(String(TOOL_OPEN) + "\n" + String(FUNCTION_OPEN) + contract.forced_tool_name + ">\n")
        self.seeded_prefix_bytes = len(self.tool_region)
        self.saw_tool_marker = True
        self.forced = True

    def feed(mut self, text: List[UInt8]) raises -> List[UInt8]:
        if self.finished:
            raise Error("tool-call output decoder is already finished")
        var visible = List[UInt8]()
        if len(text) == 0:
            return visible^
        if not self.contract.enabled:
            return text.copy()
        if self.saw_tool_marker:
            self.tool_region.extend(text.copy())
            return visible^

        var index = 0
        while index < len(text):
            var byte = text[index]
            if len(self.pending_marker) != 0:
                self.pending_marker.append(byte)
                if _opens_marker_at(self.pending_marker, 0):
                    self.tool_region = self.trailing_whitespace.copy()
                    self.trailing_whitespace = List[UInt8]()
                    self.tool_region.extend(self.pending_marker.copy())
                    for k in range(index + 1, len(text)):
                        self.tool_region.append(text[k])
                    self.pending_marker = List[UInt8]()
                    self.saw_tool_marker = True
                    break
                if _could_open_marker(self.pending_marker):
                    index += 1
                    continue
                # The byte that ended the candidate can start the next one, so it is read again.
                _ = self.pending_marker.pop()
                visible.extend(self.trailing_whitespace.copy())
                self.trailing_whitespace = List[UInt8]()
                visible.extend(self.pending_marker.copy())
                self.pending_marker = List[UInt8]()

            if byte == 0x3C:
                self.pending_marker.append(byte)
            elif _is_ws(byte):
                self.trailing_whitespace.append(byte)
            else:
                visible.extend(self.trailing_whitespace.copy())
                self.trailing_whitespace = List[UInt8]()
                visible.append(byte)
            index += 1
        return visible^

    def resolve_in_model(mut self) raises -> List[UInt8]:
        if self.finished:
            raise Error("tool-call output decoder is already finished")
        var released = List[UInt8]()
        if not self.contract.enabled:
            return released^
        released = self.trailing_whitespace.copy()
        released.extend(self.pending_marker.copy())
        for k in range(self.seeded_prefix_bytes, len(self.tool_region)):
            released.append(self.tool_region[k])
        self.trailing_whitespace = List[UInt8]()
        self.tool_region = List[UInt8]()
        self.pending_marker = List[UInt8]()
        self.seeded_prefix_bytes = 0
        self.saw_tool_marker = False
        self.forced = False
        return released^

    def finish(mut self) raises -> DecoderTerminal:
        if self.finished:
            raise Error("tool-call output decoder is already finished")
        self.finished = True
        var terminal = DecoderTerminal()
        if not self.contract.enabled:
            return terminal^

        var parsed = parse_qwen_tool_call_output(self.tool_region, self.max_tool_name_length, self.contract)
        if self.forced and parsed.diagnostics.fallback_reason != R_NONE:
            # A turn that ends after the function closed is a complete call missing only its
            # outer tag. Supplying that tag invents no argument byte; anything less complete
            # keeps what the recovery pass made of it.
            var completed = _rtrim(self.tool_region, len(self.tool_region))
            if _ends_with(completed, FUNCTION_CLOSE):
                completed.append(0x0A)
                completed.extend(_bytes_of(String(TOOL_CLOSE)))
                var closed = parse_qwen_tool_call_output(completed, self.max_tool_name_length, self.contract)
                if closed.diagnostics.fallback_reason == R_NONE:
                    closed.diagnostics.forced_call_closed = True
                    parsed = closed^
                    self.tool_region = completed^
        if self.saw_tool_marker and parsed.is_tool_call_response:
            # The parser reports the held bytes before the accepted structured region, which are
            # the bytes after an earlier quoted marker that this decoder has not published yet.
            terminal.content = parsed.content.copy()
            terminal.tool_calls = parsed.tool_calls.copy()
            terminal.diagnostics = parsed.diagnostics.copy()
            self.trailing_whitespace = List[UInt8]()
            self.tool_region = List[UInt8]()
            self.pending_marker = List[UInt8]()
            return terminal^

        var tail = self.trailing_whitespace.copy()
        tail.extend(self.pending_marker.copy())
        self.pending_marker = List[UInt8]()
        # Only what the model produced. A forced turn that never formed a closing region still
        # carries the prompt's opener at the head of the region, and returning it would put bytes
        # the model never generated into the response. saw_tool_marker is set in the constructor
        # for a forced turn, so feed() never rebuilds the region and the prefix stays at its head.
        for k in range(self.seeded_prefix_bytes, len(self.tool_region)):
            tail.append(self.tool_region[k])
        self.seeded_prefix_bytes = 0
        self.tool_region = List[UInt8]()
        terminal.content = tail^
        terminal.diagnostics = parsed.diagnostics.copy()
        return terminal^


def _ends_with(text: List[UInt8], suffix: String) -> Bool:
    var s = suffix.as_bytes()
    if len(text) < len(s):
        return False
    return _starts_with_at(text, len(text) - len(s), suffix)


# --- the constrained-decoding grammar ------------------------------------------------------------


def structured_tool_call_format(contract: ToolCallOutputContract) raises -> String:
    """Native Qwen tool-call envelope for a structured final-response request, as the JSON grammar
    the constrained decoder reads. Parameters remain non-strict values, with each declared
    parameter emitted at most once in declaration order."""
    var j = JsonOut()
    var whitespace = j.typed("regex")
    j.put(whitespace, "pattern", j.s("[ \\t\\r\\n]{0,8}"))

    var alternatives = j.arr()
    for tool in contract.tools:
        if not tool.unambiguous:
            raise Error("structured output requires unambiguous tool definitions")
        var elements = j.arr()
        j.add(elements, _literal(j, TOOL_OPEN))
        j.add(elements, whitespace)
        j.add(elements, _literal(j, String(FUNCTION_OPEN) + tool.name + ">"))
        j.add(elements, whitespace)
        for parameter in tool.parameters:
            if parameter.name.byte_length() == 0 or parameter.name.find(">") >= 0:
                raise Error("tool parameter cannot be represented in Qwen XML")
            var value = j.typed("any_text")
            var excludes = List[String]()
            excludes.append("</parameter>")
            excludes.append("<parameter=")
            excludes.append(FUNCTION_CLOSE)
            excludes.append(TOOL_OPEN)
            excludes.append(TOOL_CLOSE)
            j.put(value, "excludes", j.strings(excludes))
            var tagged = j.typed("tag")
            j.put(tagged, "begin", j.s("<parameter=" + parameter.name + ">"))
            j.put(tagged, "content", value)
            j.put(tagged, "end", j.s("</parameter>"))
            var pair = j.typed("sequence")
            var pair_elements = j.arr()
            j.add(pair_elements, tagged)
            j.add(pair_elements, whitespace)
            j.put(pair, "elements", pair_elements)
            var optional = j.typed("optional")
            j.put(optional, "content", pair)
            j.add(elements, optional)
        j.add(elements, _literal(j, FUNCTION_CLOSE))
        j.add(elements, whitespace)
        j.add(elements, _literal(j, TOOL_CLOSE))
        j.add(elements, whitespace)
        var one = j.typed("sequence")
        j.put(one, "elements", elements)
        j.add(alternatives, one)
    if len(j.doc.nodes[alternatives].items) == 0:
        return String()
    var either = j.typed("or")
    j.put(either, "elements", alternatives)
    var plus = j.typed("plus")
    j.put(plus, "content", either)
    var whole = j.typed("sequence")
    var whole_elements = j.arr()
    j.add(whole_elements, whitespace)
    j.add(whole_elements, plus)
    j.put(whole, "elements", whole_elements)
    return j.text(whole)


def _literal(mut j: JsonOut, text: String) -> Int:
    var node = j.typed("const_string")
    j.put(node, "value", j.s(text))
    return node
